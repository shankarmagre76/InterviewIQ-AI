# ==============================================================================
# INTERVIEWIQ AI FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development. NEVER commit '.env' to version control!
# ==============================================================================

# IMPORTANT SECURITY NOTICE:
# Only environment variables prefixed with VITE_ are exposed to the client-side browser bundle.
# NEVER include backend secrets (MongoDB URI, JWT secrets, Gemini API key, Cloudinary secret, SMTP passwords) here.

# REST API Base URL (Required: Set to production API URL in live deployment)
# Development Example: http://localhost:5000/api/v1
# Production Example:  https://api.interviewiq.ai/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Application Identity & Display Metadata (Optional)
VITE_APP_NAME=InterviewIQ AI
VITE_APP_ENV=development
