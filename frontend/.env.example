# InterviewIQ AI Frontend Environment Variables Template
#
# IMPORTANT SECURITY NOTICE:
# Only environment variables prefixed with VITE_ are exposed to the client-side browser bundle.
# NEVER include backend secrets (MongoDB URI, JWT secret, Gemini API keys, Cloudinary secret, SMTP passwords) here.

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=InterviewIQ AI
VITE_APP_ENV=development
