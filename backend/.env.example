# ==============================================================================
# INTERVIEWIQ AI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development. NEVER commit '.env' to version control!
# ==============================================================================

# Server Core Settings
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/interviewiq_db

# Authentication & JWT Security (Enforce 32+ character secrets in production)
JWT_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Gemini AI Integration
GEMINI_API_KEY=your_google_gemini_api_key_placeholder

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email & Nodemailer SMTP Service
EMAIL_USER=your_email_user@example.com
EMAIL_PASS=your_email_app_password

# Rate Limiting & Abuse Prevention Controls
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AI_WINDOW_MS=3600000
RATE_LIMIT_AI_MAX=10
